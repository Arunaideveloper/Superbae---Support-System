# Environment: development | production
# In production the server refuses to start with the default JWT secrets below.
NODE_ENV=development

PORT=8001
MONGODB_URI=mongodb://127.0.0.1:27017/superbae

# Use long random strings in production (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TTL=30m
REFRESH_TTL=7d

# Comma-separated allowed origins, or * for any.
CORS_ORIGIN=http://localhost:3000

# Seed demo accounts (admin/agent/priya) + demo tickets. Set false in production.
SEED_DEMO=true

# Optional Ara LLM (leave empty to use the offline keyword matcher).
GEMINI_API_KEY=
ASSISTANT_LLM_MODEL=gemini-1.5-flash

# Superbae AI layer (FastAPI RAG sidecar). Set to the sidecar URL to route Ara
# through real RAG (e.g. http://ai:8000 in Docker, http://127.0.0.1:8000 locally).
# Leave empty to use the legacy direct-Gemini path / curated-Q&A fallback.
AI_SERVICE_URL=
AI_ADMIN_API_KEY=
