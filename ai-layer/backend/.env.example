# Superbae AI layer — copy to .env and fill in. NEVER commit the real .env.
# Pick ONE provider and paste its API key. Default: Google Gemini.

AI_CUSTOMER_SUPPORT_ENABLED=true
AI_CUSTOMER_SUPPORT_PROVIDER=gemini
AI_CUSTOMER_SUPPORT_FALLBACKS=

# --- Gemini (default) ---
AI_GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI (optional) ---
AI_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# Shared admin key for the AI layer's /ai/* admin endpoints (leave blank in dev).
AI_ADMIN_API_KEY=

# Shared secret required on /chat (must match the API server).
AI_SERVICE_TOKEN=

# --- Fraud detection (AI-002) ---
# Assessments persist to Mongo when AI_MONGODB_URI is set (same DB as usage).
# Risk score bands (0-100): >= HIGH -> high, >= LOW -> medium, else low.
FRAUD_LOW_THRESHOLD=30
FRAUD_HIGH_THRESHOLD=60
# Per-signal weights (points added when a signal triggers):
FRAUD_CONVERSION_WEIGHT=30
FRAUD_VELOCITY_WEIGHT=25
FRAUD_TEMPORAL_WEIGHT=25
FRAUD_DEVICE_WEIGHT=20
FRAUD_DEFAULT_CONVERSION_BASELINE=0.08
